# Copier vers .env (ne jamais committer .env).
# Le collector lit ces variables au démarrage.

# Fuseau du lab (heure métier pour UBA)
LAB_TIMEZONE=Africa/Tunis
BUSINESS_HOUR_START=8
BUSINESS_HOUR_END=18

# Jira Cloud (optionnel : sans ces valeurs, le scoring et Cilium marchent quand même)
JIRA_BASE_URL=https://VOTRE-SITE.atlassian.net
JIRA_EMAIL=votre.email@exemple.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Task

# Email Gmail (mot de passe d'application, pas le mot de passe du compte)
GMAIL_SENDER=votre.gmail@gmail.com
GMAIL_RECEIVER=destinataire@istic.ucar.tn
GMAIL_APP_PASSWORD=

# Kubeconfig Kind généré par Terraform (défaut : terraform/devsecops-lab-config)
# KUBECONFIG=/chemin/vers/devsecops-lab-config

# Auth webhook Falcosidekick → collector (optionnel, même valeur que terraform -var falco_webhook_token)
FALCO_WEBHOOK_TOKEN=

# Bind collector
COLLECTOR_BIND_HOST=0.0.0.0
COLLECTOR_WEBHOOK_PORT=5002
COLLECTOR_METRICS_PORT=8000
HISTORY_MAX_ROWS=50000
